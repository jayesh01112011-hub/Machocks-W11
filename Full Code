<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Machocks W11 — Websites for Real Estate & Industrial Businesses</title>
<meta name="description" content="Machocks W11 designs and builds conversion-focused websites for Real Estate and Polymers & Industrial businesses across the UAE, USA and India.">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Big+Shoulders+Display:wght@500;600;700;800&family=Inter:wght@400;500;600;700&family=IBM+Plex+Mono:wght@400;500&display=swap" rel="stylesheet">
<style>
:root{
  --bg:#050308;
  --surface:#0d0812;
  --surface-2:#140b1e;
  --line:rgba(220,200,255,0.10);
  --line-soft:rgba(220,200,255,0.05);
  --ink:#f3eefc;
  --ink-dim:#a496c2;
  --ink-faint:#5c4f78;
  --violet:#b26bff;
  --violet-2:#7c3aed;
  --violet-dim:#3c2266;
  --glow:rgba(178,107,255,0.35);
  --glow-soft:rgba(124,58,237,0.20);
  --display:'Big Shoulders Display', sans-serif;
  --body:'Inter', sans-serif;
  --mono:'IBM Plex Mono', monospace;
  --ease:cubic-bezier(.16,.84,.44,1);
  --radius:14px;
}
*{box-sizing:border-box; margin:0; padding:0;}
html{scroll-behavior:smooth; overflow-x:hidden; width:100%;}
body{
  background:
    radial-gradient(ellipse 900px 500px at 15% -10%, rgba(124,58,237,0.16), transparent 60%),
    radial-gradient(ellipse 700px 500px at 100% 10%, rgba(178,107,255,0.10), transparent 55%),
    linear-gradient(var(--bg),var(--bg));
  color:var(--ink);
  font-family:var(--body);
  -webkit-font-smoothing:antialiased;
  overflow-x:hidden;
  width:100%;
  max-width:100vw;
}
@media (prefers-reduced-motion: reduce){
  *{animation-duration:.01ms !important; animation-iteration-count:1 !important; transition-duration:.01ms !important; scroll-behavior:auto !important;}
}
::selection{ background:var(--violet); color:#0a0510; }
a{ color:inherit; text-decoration:none; }
img,svg{ display:block; max-width:100%; }
button{ font:inherit; }
:focus-visible{ outline:2px solid var(--violet); outline-offset:3px; }
.wrap{ max-width:1160px; margin:0 auto; padding:0 24px; width:100%; }
section{ position:relative; overflow-x:hidden; }

/* ambient drifting glow orbs */
.orb{ position:absolute; border-radius:50%; filter:blur(90px); pointer-events:none; opacity:.55; z-index:0; }
.orb-a{ width:420px; height:420px; background:radial-gradient(circle, var(--violet-2), transparent 70%); top:-120px; right:-100px; animation:drift 16s ease-in-out infinite; }
.orb-b{ width:320px; height:320px; background:radial-gradient(circle, var(--violet), transparent 70%); bottom:-80px; left:-60px; animation:drift 20s ease-in-out infinite reverse; }
@keyframes drift{ 0%,100%{ transform:translate(0,0) scale(1); } 50%{ transform:translate(30px,-30px) scale(1.08); } }

.grid-field{
  position:absolute; inset:0; pointer-events:none;
  background-image:
    linear-gradient(var(--line-soft) 1px, transparent 1px),
    linear-gradient(90deg, var(--line-soft) 1px, transparent 1px);
  background-size:38px 38px;
  mask-image:radial-gradient(ellipse 60% 55% at 50% 20%, #000 40%, transparent 85%);
  -webkit-mask-image:radial-gradient(ellipse 60% 55% at 50% 20%, #000 40%, transparent 85%);
}

.eyebrow{
  font-family:var(--mono); font-size:11px; letter-spacing:.16em; text-transform:uppercase;
  color:var(--violet); display:flex; align-items:center; gap:10px; margin-bottom:16px;
}
.eyebrow::before{ content:''; width:20px; height:1px; background:var(--violet); }
h1,h2,h3{ font-family:var(--display); font-weight:700; letter-spacing:-0.01em; line-height:1.02; text-transform:uppercase; }
.section-head{ max-width:620px; margin-bottom:52px; }
.section-head h2{ font-size:clamp(30px,4.4vw,46px); }
.section-head p{ color:var(--ink-dim); font-size:15.5px; margin-top:16px; line-height:1.65; font-family:var(--body); font-weight:400; text-transform:none; }

.btn{
  display:inline-flex; align-items:center; justify-content:center; gap:8px;
  font-family:var(--body); font-weight:600; font-size:14px;
  padding:14px 26px; border-radius:8px; cursor:pointer; border:1px solid transparent;
  transition:transform .3s var(--ease), box-shadow .3s var(--ease), border-color .3s var(--ease), background .3s var(--ease);
  white-space:nowrap; position:relative; overflow:hidden;
}
.btn-primary{
  background:linear-gradient(135deg, #cf9bff, var(--violet) 45%, var(--violet-2) 100%);
  color:#0a0510;
  box-shadow:0 1px 0 rgba(255,255,255,0.35) inset, 0 10px 30px -12px var(--glow);
}
.btn-primary::after{
  content:''; position:absolute; inset:0;
  background:linear-gradient(115deg, transparent 20%, rgba(255,255,255,0.55) 38%, transparent 55%);
  transform:translateX(-140%); transition:transform .7s var(--ease);
}
.btn-primary:hover{ transform:translateY(-2px); box-shadow:0 1px 0 rgba(255,255,255,0.4) inset, 0 14px 34px -8px var(--glow); }
.btn-primary:hover::after{ transform:translateX(140%); }
.btn-ghost{ background:rgba(178,107,255,0.05); color:var(--ink); border-color:var(--line); backdrop-filter:blur(6px); }
.btn-ghost:hover{ border-color:rgba(220,200,255,0.35); transform:translateY(-2px); background:rgba(178,107,255,0.1); }

.reveal{ opacity:0; transform:translateY(20px); transition:opacity .8s var(--ease), transform .8s var(--ease); }
.reveal.in{ opacity:1; transform:translateY(0); }
.stagger > *{ transition-delay:calc(var(--i,0) * 80ms); }

/* signature dot-grid mark — used as logo glyph + FAQ toggle */
.dotmark{ display:grid; grid-template-columns:repeat(3,1fr); gap:3px; flex-shrink:0; }
.dotmark i{ width:5px; height:5px; border-radius:50%; background:var(--ink-faint); transition:background .35s var(--ease), transform .35s var(--ease), box-shadow .35s var(--ease); display:block; }
.dotmark i:nth-child(5){ background:var(--violet); box-shadow:0 0 8px var(--glow); }
.nav-logo .dotmark{ width:22px; height:22px; }
.nav-logo .dotmark i{ width:5px; height:5px; }
.nav-logo:hover .dotmark i{ transform:scale(1.15); }
.nav-logo:hover .dotmark i:nth-child(5){ box-shadow:0 0 14px var(--glow); }

/* NAV */
.nav{
  position:fixed; top:0; left:0; right:0; z-index:200;
  display:flex; align-items:center; justify-content:space-between;
  padding:16px 24px; backdrop-filter:blur(14px);
  background:rgba(5,3,8,0.6); border-bottom:1px solid transparent;
  transition:border-color .4s var(--ease), background .4s var(--ease);
}
.nav.scrolled{ border-color:var(--line); background:rgba(5,3,8,0.9); }
.nav-logo{ display:flex; align-items:center; gap:11px; font-family:var(--display); font-weight:700; font-size:17px; letter-spacing:.03em; }
.nav-links{ display:none; align-items:center; gap:30px; font-size:13px; color:var(--ink-dim); font-family:var(--mono); letter-spacing:.02em; }
.nav-links a{ transition:color .25s; position:relative; }
.nav-links a::after{ content:''; position:absolute; left:0; right:0; bottom:-6px; height:1px; background:var(--violet); transform:scaleX(0); transform-origin:left; transition:transform .3s var(--ease); }
.nav-links a:hover{ color:var(--ink); }
.nav-links a:hover::after{ transform:scaleX(1); }
.nav-cta{ display:flex; align-items:center; gap:12px; }
.nav-cta .btn-ghost{ display:none; }
.nav-burger{ display:flex; width:38px; height:38px; align-items:center; justify-content:center; border:1px solid var(--line); border-radius:8px; background:transparent; color:var(--ink); cursor:pointer; }
@media(min-width:880px){
  .nav-links, .nav-cta .btn-ghost{ display:flex; }
  .nav-burger{ display:none; }
}
.mobile-menu{
  position:fixed; inset:0; z-index:190; background:rgba(5,3,8,0.98);
  display:flex; flex-direction:column; align-items:center; justify-content:center; gap:28px;
  opacity:0; pointer-events:none; transition:opacity .3s var(--ease);
}
.mobile-menu.open{ opacity:1; pointer-events:auto; }
.mobile-menu a{ font-family:var(--display); font-size:28px; text-transform:uppercase; letter-spacing:.02em; color:var(--ink); }

/* HERO */
.hero{ padding:150px 0 100px; overflow:hidden; }
.hero-copy{ max-width:760px; position:relative; z-index:1; }
.hero-copy h1{ font-size:clamp(38px,7vw,74px); }
.hero-copy h1 .accent{
  background:linear-gradient(100deg, #e6cfff, var(--violet) 55%, var(--violet-2));
  -webkit-background-clip:text; background-clip:text; color:transparent;
}
.hero-sub{ font-family:var(--mono); font-size:14px; color:#c9a6ff; max-width:600px; margin:22px 0 0; letter-spacing:.02em; }
.hero-desc{ font-size:15.5px; color:var(--ink-dim); max-width:560px; margin:16px 0 0; line-height:1.7; }
.hero-ctas{ display:flex; gap:14px; margin-top:34px; flex-wrap:wrap; }

/* PROOF STRIP */
.proof{ padding:52px 0; border-top:1px solid var(--line); border-bottom:1px solid var(--line); position:relative; z-index:1; }
.proof-row{ display:flex; flex-wrap:wrap; align-items:center; justify-content:center; gap:14px; }
.proof-chip{
  font-family:var(--mono); font-size:12px; letter-spacing:.08em; text-transform:uppercase;
  padding:10px 18px; border:1px solid var(--line); border-radius:100px; color:var(--ink-dim);
  display:flex; align-items:center; gap:8px; transition:border-color .3s, transform .3s var(--ease);
}
.proof-chip:hover{ border-color:rgba(178,107,255,0.4); transform:translateY(-2px); }
.proof-chip b{ color:var(--ink); font-weight:600; }
.proof-sep{ width:22px; height:1px; background:var(--line); }
@media(max-width:640px){ .proof-sep{ display:none; } }

/* ABOUT */
.about{ padding:110px 0; }
.problem-grid{ display:grid; grid-template-columns:repeat(4,1fr); gap:16px; }
.problem-card{
  background:linear-gradient(160deg, var(--surface), var(--surface-2));
  border:1px solid var(--line); border-radius:var(--radius); padding:26px;
  transition:transform .4s var(--ease), border-color .4s var(--ease), box-shadow .4s var(--ease);
}
.problem-card:hover{ transform:translateY(-4px); border-color:rgba(178,107,255,0.35); box-shadow:0 18px 40px -22px var(--glow); }
.problem-card .picon{ width:34px; height:34px; margin-bottom:16px; }
.problem-card h3{ font-size:17px; margin-bottom:8px; text-transform:none; letter-spacing:0; }
.problem-card p{ font-size:13.5px; color:var(--ink-dim); line-height:1.6; }
@media(max-width:980px){ .problem-grid{ grid-template-columns:1fr 1fr; } }
@media(max-width:560px){ .problem-grid{ grid-template-columns:1fr; } }

/* SERVICES */
.services{ padding:0 0 110px; }
.svc-grid{ display:grid; grid-template-columns:repeat(3,1fr); gap:16px; }
.svc-card{
  background:linear-gradient(160deg, var(--surface), var(--surface-2));
  border:1px solid var(--line); border-radius:var(--radius); padding:26px; position:relative; overflow:hidden;
  transition:transform .35s var(--ease), border-color .35s;
}
.svc-card::before{ content:''; position:absolute; inset:-1px; background:radial-gradient(240px circle at var(--mx,50%) var(--my,0%), var(--glow), transparent 70%); opacity:0; transition:opacity .4s; pointer-events:none; }
.svc-card::after{ content:''; position:absolute; top:0; left:-60%; width:40%; height:100%; background:linear-gradient(100deg, transparent, rgba(255,255,255,0.06), transparent); transform:skewX(-20deg); }
.svc-card:hover{ transform:translateY(-5px); border-color:rgba(178,107,255,0.4); }
.svc-card:hover::before{ opacity:1; }
.svc-card .tag{ font-family:var(--mono); font-size:10px; letter-spacing:.1em; text-transform:uppercase; color:#c9a6ff; }
.svc-card h3{ font-size:17px; margin:12px 0 8px; text-transform:none; letter-spacing:0; }
.svc-card p{ font-size:13.5px; color:var(--ink-dim); line-height:1.6; }
@media(max-width:900px){ .svc-grid{ grid-template-columns:1fr 1fr; } }
@media(max-width:600px){ .svc-grid{ grid-template-columns:1fr; } }

/* INDUSTRIES */
.industries{ padding:0 0 110px; }
.ind-tabs{ display:flex; gap:10px; margin-bottom:32px; flex-wrap:wrap; }
.ind-tab{ font-family:var(--mono); font-size:12px; letter-spacing:.05em; text-transform:uppercase; padding:11px 20px; border-radius:100px; border:1px solid var(--line); color:var(--ink-dim); cursor:pointer; transition:all .3s; background:transparent; }
.ind-tab.active{ background:linear-gradient(135deg,#cf9bff,var(--violet-2)); color:#0a0510; border-color:transparent; box-shadow:0 8px 22px -10px var(--glow); }
.ind-panel{ display:none; grid-template-columns:1fr 1fr; gap:0; background:linear-gradient(160deg, var(--surface), var(--surface-2)); border:1px solid var(--line); border-radius:18px; overflow:hidden; }
.ind-panel.active{ display:grid; animation:fadeUp .5s var(--ease); }
@keyframes fadeUp{ from{ opacity:0; transform:translateY(10px);} to{ opacity:1; transform:translateY(0);} }
.ind-col{ padding:34px; }
.ind-col.pain{ border-right:1px solid var(--line); }
.ind-col h4{ font-family:var(--mono); font-size:11px; letter-spacing:.1em; text-transform:uppercase; color:var(--ink-faint); margin-bottom:18px; }
.ind-col.sol h4{ color:#c9a6ff; }
.ind-col ul{ list-style:none; }
.ind-col li{ font-size:14px; color:var(--ink-dim); padding:11px 0; border-top:1px solid var(--line-soft); line-height:1.5; }
.ind-col li:first-child{ border-top:none; }
.ind-col.sol li::before{ content:'→  '; color:var(--violet); font-family:var(--mono); }
.ind-col.pain li::before{ content:'·  '; color:var(--ink-faint); }
@media(max-width:700px){ .ind-panel{ grid-template-columns:1fr; } .ind-col.pain{ border-right:none; border-bottom:1px solid var(--line); } }

/* PROCESS */
.process{ padding:0 0 110px; }
.timeline{ position:relative; padding-left:28px; }
.timeline::before{ content:''; position:absolute; left:0; top:6px; bottom:6px; width:1px; background:var(--line); }
.t-step{ position:relative; padding:0 0 40px 26px; }
.t-step:last-child{ padding-bottom:0; }
.t-step::before{ content:''; position:absolute; left:-33px; top:4px; width:9px; height:9px; border-radius:2px; background:var(--surface-2); border:1px solid var(--line); transform:rotate(45deg); transition:background .4s, border-color .4s, box-shadow .4s; }
.t-step.in::before{ background:var(--violet); border-color:var(--violet); box-shadow:0 0 12px var(--glow); }
.t-step .trev{ font-family:var(--mono); font-size:11px; color:#c9a6ff; letter-spacing:.08em; }
.t-step h3{ font-size:19px; margin:6px 0 6px; text-transform:none; letter-spacing:0; }
.t-step p{ font-size:13.5px; color:var(--ink-dim); max-width:480px; line-height:1.6; font-family:var(--body); font-weight:400; }

/* PRICING */
.pricing{ padding:0 0 110px; }
.price-grid{ display:grid; grid-template-columns:repeat(3,1fr); gap:18px; align-items:stretch; }
.sheet{
  background:linear-gradient(165deg, var(--surface), var(--surface-2));
  border:1px solid var(--line); border-radius:var(--radius); display:flex; flex-direction:column; overflow:hidden;
  transition:transform .35s var(--ease), border-color .35s;
}
.sheet:hover{ transform:translateY(-5px); }
.sheet.featured{ border-color:rgba(178,107,255,0.55); box-shadow:0 24px 55px -22px var(--glow); position:relative; }
.sheet.featured::before{ content:''; position:absolute; inset:0; padding:1px; border-radius:var(--radius); background:linear-gradient(160deg, rgba(178,107,255,0.6), transparent 40%); -webkit-mask:linear-gradient(#000 0 0) content-box, linear-gradient(#000 0 0); -webkit-mask-composite:xor; mask-composite:exclude; pointer-events:none; }
.sheet-block{ display:flex; justify-content:space-between; align-items:center; padding:14px 22px; border-bottom:1px solid var(--line); font-family:var(--mono); font-size:10.5px; letter-spacing:.08em; text-transform:uppercase; color:var(--ink-faint); }
.sheet-block .badge{ color:var(--violet); }
.sheet-body{ padding:28px 26px 30px; display:flex; flex-direction:column; flex:1; }
.sheet-body h3{ font-size:24px; text-transform:none; letter-spacing:0; }
.sheet-price{ font-family:var(--display); font-size:52px; font-weight:800; margin:12px 0 4px; letter-spacing:0; background:linear-gradient(135deg,#f3eefc,#c9a6ff); -webkit-background-clip:text; background-clip:text; color:transparent; }
.sheet-price span{ font-family:var(--mono); font-size:13px; color:var(--ink-faint); font-weight:400; margin-left:6px; -webkit-background-clip:initial; background-clip:initial; color:var(--ink-faint); }
.sheet-note{ font-size:13px; color:var(--ink-dim); margin-bottom:22px; }
.sheet-feats{ list-style:none; margin-bottom:26px; flex:1; }
.sheet-feats li{ font-size:13.5px; color:var(--ink-dim); padding:9px 0; border-top:1px solid var(--line-soft); display:flex; gap:10px; }
.sheet-feats li:first-child{ border-top:none; }
.sheet-feats li::before{ content:'＋'; color:var(--violet); font-family:var(--mono); font-size:12px; }
.price-foot{ text-align:center; font-family:var(--mono); font-size:12px; color:var(--ink-faint); margin-top:28px; }
@media(max-width:960px){ .price-grid{ grid-template-columns:1fr; } }

/* CONTACT */
.contact{ padding:0 0 110px; }
.contact-grid{ display:grid; grid-template-columns:repeat(3,1fr); gap:16px; margin-bottom:18px; }
.region-card{
  background:linear-gradient(160deg, var(--surface), var(--surface-2));
  border:1px solid var(--line); border-radius:var(--radius); padding:24px;
  transition:transform .35s var(--ease), border-color .35s;
}
.region-card:hover{ transform:translateY(-4px); border-color:rgba(178,107,255,0.35); }
.region-card .rflag{ font-family:var(--mono); font-size:10px; letter-spacing:.1em; color:#c9a6ff; text-transform:uppercase; margin-bottom:10px; }
.region-card h3{ font-size:19px; text-transform:none; letter-spacing:0; margin-bottom:6px; }
.region-card p{ font-size:13px; color:var(--ink-dim); line-height:1.55; }
.contact-cta{
  background:linear-gradient(135deg, var(--surface-2), #1a0e2b);
  border:1px solid var(--line); border-radius:var(--radius); padding:30px;
  display:flex; align-items:center; justify-content:space-between; gap:20px; flex-wrap:wrap;
}
.contact-cta p{ font-size:14px; color:var(--ink-dim); }
.contact-cta strong{ color:var(--ink); font-family:var(--mono); font-size:15px; letter-spacing:.02em; }
@media(max-width:900px){ .contact-grid{ grid-template-columns:1fr; } }

/* FAQ */
.faq{ padding:0 0 110px; }
.faq-item{ border-top:1px solid var(--line); padding:22px 0; cursor:pointer; }
.faq-item:last-child{ border-bottom:1px solid var(--line); }
.faq-q{ display:flex; justify-content:space-between; align-items:center; font-size:15.5px; font-weight:600; gap:20px; }
.faq-q .dotmark{ transition:transform .4s var(--ease); }
.faq-item.open .faq-q .dotmark{ transform:rotate(90deg); }
.faq-item.open .faq-q .dotmark i{ background:var(--violet-dim); }
.faq-item.open .faq-q .dotmark i:nth-child(5){ background:var(--violet); box-shadow:0 0 10px var(--glow); }
.faq-a{ max-height:0; overflow:hidden; transition:max-height .4s var(--ease); }
.faq-item.open .faq-a{ max-height:220px; }
.faq-a p{ font-size:14px; color:var(--ink-dim); padding-top:14px; line-height:1.65; max-width:680px; }

/* FINAL CTA */
.final-cta{ padding:110px 0 100px; text-align:center; position:relative; overflow:hidden; }
.final-cta::before{ content:''; position:absolute; inset:0; background:radial-gradient(ellipse at center, rgba(178,107,255,0.14), transparent 60%); pointer-events:none; }
.final-cta h2{ font-size:clamp(32px,5.5vw,54px); position:relative; }
.final-cta p{ color:var(--ink-dim); margin-top:16px; font-size:15.5px; position:relative; font-family:var(--body); text-transform:none; font-weight:400; }
.final-cta .hero-ctas{ position:relative; justify-content:center; }

/* FOOTER */
footer{ border-top:1px solid var(--line); padding:40px 0; }
.foot-grid{ display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:18px; }
.foot-grid p{ font-size:12px; color:var(--ink-faint); font-family:var(--mono); }
.foot-links{ display:flex; gap:22px; font-size:12px; color:var(--ink-faint); font-family:var(--mono); }
.foot-links a:hover{ color:var(--ink); }
</style>
</head>
